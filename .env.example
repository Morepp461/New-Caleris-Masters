# Local development only. Never copy this database name into production.
# Keep the existing .env.local untouched when updating this template.
MONGODB_URI=
MONGODB_DB=caleris_masters_dev

# Discord OAuth credentials are supplied by the project owner before enabling login.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/callback
