# MongoDB Atlas
MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/caleris_masters?retryWrites=true&w=majority
MONGODB_DB=caleris_masters

# Initial administrator account (use a strong, unique password)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_DISPLAY_NAME=Caleris Administrator
